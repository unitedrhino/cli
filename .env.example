# Release 发布环境变量配置
# 复制本文件为 .env 并填入真实 token：
#   cp .env.example .env
#
# .env 文件已被 .gitignore 忽略，不会提交到仓库

# GitHub 个人访问令牌（用于创建 GitHub Release）
# 获取方式：GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# 权限要求：repo（完整仓库权限）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gitee 私人令牌（用于创建 Gitee Release）
# 获取方式：Gitee → 个人设置 → 私人令牌 → 生成新令牌
# 权限要求：projects
GITEE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
