{
  "formatVersion": 1,
  "name": "舒适家 · 智能空调",
  "version": "1.2.0",
  "entry": "index.html",
  "sdkVersion": "1.0.0",
  "platforms": [
    "web",
    "h5",
    "appAndroid",
    "appIos"
  ],
  "requirements": [
    {
      "kind": "property",
      "identifier": "power",
      "required": true,
      "access": "write",
      "define": {
        "type": "bool"
      }
    },
    {
      "kind": "property",
      "identifier": "targetTemperature",
      "required": true,
      "access": "write",
      "define": {
        "type": "int",
        "min": "16",
        "max": "30",
        "step": "1",
        "unit": "°C"
      }
    },
    {
      "kind": "property",
      "identifier": "mode",
      "required": true,
      "access": "write",
      "define": {
        "type": "enum",
        "mapping": {
          "0": "制冷",
          "1": "制热",
          "2": "除湿",
          "3": "自动"
        }
      }
    },
    {
      "kind": "property",
      "identifier": "fanSpeed",
      "required": true,
      "access": "write",
      "define": {
        "type": "enum",
        "mapping": {
          "0": "自动",
          "1": "低风",
          "2": "中风",
          "3": "高风"
        }
      }
    },
    {
      "kind": "property",
      "identifier": "currentTemperature",
      "required": false,
      "access": "read",
      "define": {
        "type": "float",
        "unit": "°C"
      }
    }
  ],
  "cover": ".data/cover.png",
  "readme": "README.md",
  "skills": [
    "skills/panel-development.md"
  ],
  "thingModel": ".data/thing-model.json"
}
